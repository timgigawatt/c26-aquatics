---
/**
 * Form success page. The contact form's `action` points here so a submit
 * without JS (or when the AJAX path falls back) lands on-site instead of
 * Netlify's generic success page. Unlinked and noindex; dropped from the sitemap.
 */
import Base from '@layouts/Base.astro';
import Header from '@components/layout/Header.astro';
import Footer from '@components/layout/Footer.astro';
import Button from '@components/ui/Button.astro';
---
<Base title="Thanks | C26 Aquatics" description="We've got your message.">
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>

  <Header />
  <main class="thanks">
    <div class="container thanks__inner">
      <h1 class="thanks__title">Message sent</h1>
      <p class="thanks__text">Thanks — a coach will get back to you within one business day.</p>
      <Button href="/" variant="primary" size="lg">Back to the homepage</Button>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .thanks {
    background: linear-gradient(180deg, var(--paper) 0%, var(--mist) 100%);
    padding: var(--space-20) 0;
    min-height: 50vh;
    display: flex;
    align-items: center;
  }
  .thanks__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-4);
    max-width: 560px;
    margin-inline: auto;
  }
  .thanks__title {
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    letter-spacing: var(--ls-tight);
    font-size: clamp(36px, 5vw, 56px);
    color: var(--navy-700);
    margin: 0;
  }
  .thanks__text {
    font-size: 19px;
    line-height: 1.5;
    color: var(--text-body);
    margin: 0 0 var(--space-2);
  }
</style>
