    {
      "blockType": "faq",
      "heading": "Team FAQs",
      "items": [
        {
          "question": "How do tryouts work for the competitive team?",
          "answer": "We don't run traditional cut-day tryouts. Instead, every new family books a **free water evaluation** with one of our coaches. Your swimmer swims a short set of skills — usually 25s of each stroke they know, a streamline, and a few laps for endurance — and the coach recommends a starting training group with clear next-step goals. Most evaluations take about 20 minutes.",
          "id": "6a5b95157a9f7700012d94db"
        }
      ],
